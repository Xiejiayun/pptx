{
  "name": "pptx-ooxml",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:fuzz": "vitest run packages/testkit/src/fuzz.test.ts",
    "test:performance": "RUN_PERF=1 vitest run packages/testkit/src/performance.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "check": "pnpm typecheck && pnpm test",
    "cli": "node packages/cli/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
